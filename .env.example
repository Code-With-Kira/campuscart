# CampusCart frontend/backend handoff (public settings ONLY; never put secrets here).
# Default: the existing Nuxt /api/v1 mock handlers, preserving the finished frontend.
NUXT_PUBLIC_API_BASE=/api/v1

# To switch to a backend after its API contract, CORS/cookies and auth are agreed:
# NUXT_PUBLIC_API_BASE=http://localhost:4000/api/v1

# Disabled by default. For LOCAL QA of the mock admin persona only,
# set to true in a private .env while running `npm run dev`. NEVER enable on public builds.
NUXT_PUBLIC_ENABLE_DEMO_PREVIEW=false
